# Environment configuration example for the publisher FastAPI port.
# Copy to `.env` and fill in real values; never commit real secrets.
#
# ADR-003: GHOST_API_KEY is loaded from the env/secret store only. The
# credential literal from the source constants.js must never appear in this
# repository or its history — scripts/smoke.py scans every file for it.

# Process contract (bin/www equivalent): default port 9222, all interfaces.
NODE_ENV=development
PORT=9222

# Multi-tenant resolution (all recorded scenarios run under DEBUG=1 with ?domain=<slug>).
DEBUG=1
ROOT_DOMAIN=localhost:9222
DOMAIN_QUERY_PARAM=domain
HTTPS_DOMAIN=0

# External tasks service: the memories page calls ${TASKS_URL}/memories/public/${userId} from the browser.
TASKS_URL=http://localhost:9210

# Read-only Postgres btw schema (matches docker-compose.yml local stack).
TASKS_DATABASE_URL=postgres://postgres:postgres@localhost:55432/btw

# Umami analytics embed.
UMAMI_SOURCE=

# ADMIN_SLUG single-user mode: when TURN_OFF_SINGLE_USER_MODE is falsy and
# ADMIN_SLUG is set, every cache getter rewrites the slug to ADMIN_SLUG.
ADMIN_SLUG=
TURN_OFF_SINGLE_USER_MODE=

# Ghost backend (constants.js absorbed as configuration only).
GHOST_URL=https://blog-admin.btw.so
GHOST_API_KEY=<load-from-secret-store>
BLOG_CATEGORIES=blog,product,help,guides
